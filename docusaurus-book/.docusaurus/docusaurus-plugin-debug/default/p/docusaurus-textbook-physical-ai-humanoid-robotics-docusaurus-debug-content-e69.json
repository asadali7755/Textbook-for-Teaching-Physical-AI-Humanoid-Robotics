{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs","tagsPath":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/tags","editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs","isLast":true,"routePriority":-1,"sidebarFilePath":"C:\\Users\\leo ali\\OneDrive\\Desktop\\ai_native_human_robotic book\\docusaurus-book\\sidebars.js","contentPath":"C:\\Users\\leo ali\\OneDrive\\Desktop\\ai_native_human_robotic book\\docusaurus-book\\docs","docs":[{"id":"conversational-robotics/conversational-robotics-intro","title":"Conversational Robotics","description":"This chapter explores conversational robotics, which encompasses the design and implementation of robots capable of natural, multimodal interaction with humans through spoken and written language. Conversational robotics builds on VLA systems to enable sophisticated human-robot interaction through natural language interfaces.","source":"@site/docs/conversational-robotics/index.md","sourceDirName":"conversational-robotics","slug":"/conversational-robotics/","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/conversational-robotics/","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/conversational-robotics/index.md","tags":[],"version":"current","frontMatter":{"id":"conversational-robotics-intro","title":"Conversational Robotics"},"sidebar":"textbook","previous":{"title":"Vision-Language-Action (VLA) Systems","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/vla-systems/"},"next":{"title":"Week 1 - Introduction to Physical AI","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/weekly-breakdowns/week-1"}},{"id":"intro","title":"Introduction","description":"Welcome to the Physical AI & Humanoid Robotics textbook. This comprehensive guide covers the fundamental concepts, development techniques, and practical applications of physical artificial intelligence and humanoid robotics.","source":"@site/docs/intro.md","sourceDirName":".","slug":"/intro","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/intro","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/intro.md","tags":[],"version":"current","frontMatter":{"title":"Introduction"},"sidebar":"textbook","next":{"title":"ROS 2 Fundamentals","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/"}},{"id":"nvidia-isaac/nvidia-isaac-intro","title":"NVIDIA Isaac Platform","description":"This chapter introduces the NVIDIA Isaac platform, a comprehensive solution for developing, simulating, and deploying AI-powered robots. The platform combines NVIDIA's GPU computing capabilities with specialized tools and frameworks for robotics applications.","source":"@site/docs/nvidia-isaac/index.md","sourceDirName":"nvidia-isaac","slug":"/nvidia-isaac/","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/nvidia-isaac/","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/nvidia-isaac/index.md","tags":[],"version":"current","frontMatter":{"id":"nvidia-isaac-intro","title":"NVIDIA Isaac Platform"},"sidebar":"textbook","previous":{"title":"Robot Simulation with Unity","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/unity"},"next":{"title":"Vision-Language-Action (VLA) Systems","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/vla-systems/"}},{"id":"robot-simulation/gazebo","title":"Robot Simulation with Gazebo","description":"This chapter covers the use of Gazebo, a powerful robotics simulator that provides accurate physics simulation, high-quality graphics, and convenient programmatic interfaces.","source":"@site/docs/robot-simulation/gazebo.md","sourceDirName":"robot-simulation","slug":"/robot-simulation/gazebo","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/gazebo","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/robot-simulation/gazebo.md","tags":[],"version":"current","frontMatter":{"id":"gazebo","title":"Robot Simulation with Gazebo"},"sidebar":"textbook","previous":{"title":"ROS 2 Examples and Best Practices","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/ros2-examples"},"next":{"title":"Robot Simulation with Unity","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/unity"}},{"id":"robot-simulation/unity","title":"Robot Simulation with Unity","description":"This chapter covers the use of Unity, a powerful game engine that has been adapted for robotics simulation, particularly for scenarios requiring high-fidelity graphics and complex environments.","source":"@site/docs/robot-simulation/unity.md","sourceDirName":"robot-simulation","slug":"/robot-simulation/unity","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/unity","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/robot-simulation/unity.md","tags":[],"version":"current","frontMatter":{"id":"unity","title":"Robot Simulation with Unity"},"sidebar":"textbook","previous":{"title":"Robot Simulation with Gazebo","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/gazebo"},"next":{"title":"NVIDIA Isaac Platform","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/nvidia-isaac/"}},{"id":"ros2-fundamentals/ros2-concepts","title":"Core ROS 2 Concepts","description":"This section delves deeper into the fundamental concepts that make ROS 2 a powerful framework for robotics development.","source":"@site/docs/ros2-fundamentals/concepts.md","sourceDirName":"ros2-fundamentals","slug":"/ros2-fundamentals/ros2-concepts","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/ros2-concepts","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/ros2-fundamentals/concepts.md","tags":[],"version":"current","frontMatter":{"id":"ros2-concepts","title":"Core ROS 2 Concepts"},"sidebar":"textbook","previous":{"title":"ROS 2 Fundamentals","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/"},"next":{"title":"ROS 2 Examples and Best Practices","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/ros2-examples"}},{"id":"ros2-fundamentals/ros2-examples","title":"ROS 2 Examples and Best Practices","description":"This section provides practical examples of ROS 2 concepts and best practices for implementing them in humanoid robotics systems.","source":"@site/docs/ros2-fundamentals/examples.md","sourceDirName":"ros2-fundamentals","slug":"/ros2-fundamentals/ros2-examples","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/ros2-examples","draft":false,"unlisted":false,"editUrl":"https://github.com/your-username/your-repo/edit/main/docusaurus-book/docs/ros2-fundamentals/examples.md","tags":[],"version":"current","frontMatter":{"id":"ros2-examples","title":"ROS 2 Examples and Best Practices"},"sidebar":"textbook","previous":{"title":"Core ROS 2 Concepts","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/ros2-fundamentals/ros2-concepts"},"next":{"title":"Robot Simulation with Gazebo","permalink":"/docusaurus-textbook-physical-ai-humanoid-robotics/docs/robot-simulation/gazebo"}},{"id":"ros2-fundamentals/ros2-intro","title":"ROS 2 Fundamentals","description":"This chapter introduces the Robot Operating System (ROS 2),